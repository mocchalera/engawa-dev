{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "engawa-pilot",
  "main": "remote/worker.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "remote/public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [
    { "name": "DIRECTORY", "class_name": "Directory" },
    { "name": "WORKBENCHES", "class_name": "Workbench" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Directory", "Workbench"] }],
  "observability": { "enabled": false }
}
