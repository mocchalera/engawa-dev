{
  "name": "engawa-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "pretest": "npm run build:remote",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server/index.mjs && node --check public/app.js && node --check remote/app.js && tsc --noEmit && npm test",
    "build:remote": "node scripts/build-remote.mjs",
    "dev:remote": "npm run build:remote && wrangler dev --ip 127.0.0.1",
    "pretest:remote": "npm run build:remote",
    "test:remote": "node --test tests/remote.test.mjs"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20260903.0-alpha",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.0"
  }
}
